# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Database Connection URL (PostgreSQL / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/ekos_tracker?schema=public"

# JWT Secret Key (Use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional Auto-Seed Flag (Set to true only when seeding test data)
ENABLE_SEED=false
