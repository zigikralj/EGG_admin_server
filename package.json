{
  "name": "ekos-project-tracker-server",
  "version": "1.0.0",
  "description": "Backend API for Ekos Green Group Project Tracker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:local": "DOTENV_CONFIG_PATH=.env.localhost ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:resolve": "prisma migrate resolve",
    "db:seed": "ts-node-dev src/seed.ts",
    "db:import-clients": "DOTENV_CONFIG_PATH=.env.localhost ts-node src/importClientsCsv.ts",
    "db:import-clients:neon": "DOTENV_CONFIG_PATH=.env.neon ts-node src/importClientsCsv.ts",
    "db:import-waste": "DOTENV_CONFIG_PATH=.env.localhost ts-node src/importWasteDisposalExcel.ts",
    "db:import-waste:neon": "DOTENV_CONFIG_PATH=.env.neon ts-node src/importWasteDisposalExcel.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
