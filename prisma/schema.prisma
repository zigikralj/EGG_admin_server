datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id            String   @id @default(uuid())
  name          String
  clientId      String?
  clientName    String
  responsible   String?
  responsibleId String?
  type          String
  start         String?
  deadline      String?
  progress      Int      @default(0)
  done          Boolean  @default(false)
  nextSample    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client?  @relation(fields: [clientId], references: [id])
  responsibleUser User?  @relation(fields: [responsibleId], references: [id])
  reminders     Reminder[]
  invoices      Invoice[]
  providedServices ProvidedService[]
}

model Client {
  id            String    @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  city          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
  reminders     Reminder[]
  invoices      Invoice[]
  providedServices ProvidedService[]
}

model User {
  id          String           @id @default(uuid())
  name        String
  email       String?
  password    String?
  isApproved  Boolean          @default(true)
  status      String           @default("APPROVED")
  role        String           @default("User")
  phone       String?
  avatarUrl   String?
  gender      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  projects    Project[]
  preferences UserPreference[]
  reminders   Reminder[]
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Service {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  group       String
  frequency   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  providedServices ProvidedService[]
}

model Reminder {
  id            String   @id @default(uuid())
  title         String?
  projectId     String?
  projectName   String?
  clientId      String?
  clientName    String?
  responsibleId String?
  responsible   String?
  status        String   @default("Pending")
  notes         String?
  dueDate       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responsibleUser User?    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  dateCreated   String?
  dueDate       String?
  paymentDate   String?
  clientId      String?
  clientName    String?
  projectId     String?
  projectName   String?
  status        String        @default("Draft")
  notes         String?
  totalAmount   Float?        @default(0)
  currency      String?       @default("RSD")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  providedServices ProvidedService[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  currency    String   @default("RSD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ProvidedService {
  id             String    @id @default(uuid())
  serviceId      String
  clientId       String
  projectId      String?
  invoiceId      String?
  status         String    @default("Planned")
  location       String?
  scheduledDate  String?
  completionDate String?
  price          Float?    @default(0)
  currency       String?   @default("RSD")
  notes          String?
  customData     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  service        Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}


model CompanyInfo {
  id                 String   @id @default("default")
  name               String   @default("EKOS GREEN GROUP")
  legalName          String   @default("EKOS GREEN GROUP DOO Kraljevo")
  registrationNumber String   @default("21823759")
  municipality       String   @default("KRALJEVO")
  city               String   @default("KRALJEVO")
  streetAddress      String   @default("HEROJA MARIČIĆA 18")
  postalCode         String   @default("36000")
  postOffice         String   @default("KRALJEVO")
  email              String   @default("office@ekosgroup.rs")
  taxId              String   @default("113207057")
  activityCode       String   @default("7490 - Ostale stručne, naučne i tehničke delatnosti")
  bankAccounts       String[] @default(["325-9500700212451-35", "205-0000000547461-12", "205-0070100584938-90", "325-9601700087442-40", "325-9500700218732-10", "205-0000000525461-52"])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
