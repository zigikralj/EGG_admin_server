datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id            String   @id @default(uuid())
  name          String
  clientId      String?
  clientName    String
  responsible   String?
  responsibleId String?
  type          String
  start         String?
  deadline      String?
  progress      Int      @default(0)
  done          Boolean  @default(false)
  notesPreview  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client           Client?           @relation(fields: [clientId], references: [id])
  responsibleUser  User?             @relation(fields: [responsibleId], references: [id])
  reminders        Reminder[]
  notifications    Notification[]
  invoices         Invoice[]
  providedServices ProvidedService[]
  note             ProjectNote?

  @@index([deadline])
  @@index([start])
  @@index([createdAt])
  @@index([clientId])
  @@index([responsibleId])
  @@index([done])
  @@index([type])
  @@index([updatedAt])
}

model Client {
  id               String            @id @default(uuid())
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  city             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projects         Project[]
  reminders        Reminder[]
  invoices         Invoice[]
  providedServices ProvidedService[]
  extraData        ClientExtraData?
  permits          Permit[]

  @@index([name])
  @@index([city])
  @@index([createdAt])
  @@index([updatedAt])
}

model User {
  id            String           @id @default(uuid())
  name          String
  email         String?          @unique
  password      String?
  isApproved    Boolean          @default(true)
  status        String           @default("APPROVED")
  role          String           @default("User")
  roleEntity    Role?            @relation(fields: [role], references: [name])
  phone         String?
  avatarUrl     String?
  gender        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  projects      Project[]
  preferences   UserPreference[]
  reminders     Reminder[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  activityMonthlyStats  ActivityLogMonthlyStats[]
  updatedProjectNotes   ProjectNote[]

  @@index([role])
  @@index([status])
  @@index([name])
  @@index([updatedAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Service {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  group            String
  frequency        Int               @default(0)
  description      String?
  customDataModel  Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  providedServices ProvidedService[]
}

model Reminder {
  id            String   @id @default(uuid())
  title         String?
  projectId     String?
  projectName   String?
  clientId      String?
  clientName    String?
  responsibleId String?
  responsible   String?
  status        String   @default("Pending")
  notes         String?
  dueDate       String?
  permitId      String?
  permitNumber  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responsibleUser User?    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  permit          Permit?  @relation(fields: [permitId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([status])
  @@index([responsibleId])
  @@index([projectId])
  @@index([clientId])
  @@index([permitId])
  @@index([updatedAt])
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  invoiceType     String?  @default("Standard")
  parentInvoiceId String?
  dateCreated   String?
  dueDate       String?
  paymentDate   String?
  clientId      String?
  clientName    String?
  projectId     String?
  projectName   String?
  status        String   @default("Draft")
  notes         String?
  totalAmount   Float?   @default(0)
  currency      String?  @default("RSD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  providedServices ProvidedService[]
  parentInvoice    Invoice?          @relation("ParentChildInvoices", fields: [parentInvoiceId], references: [id], onDelete: SetNull)
  childInvoices    Invoice[]         @relation("ParentChildInvoices")

  @@index([dueDate])
  @@index([dateCreated])
  @@index([status])
  @@index([clientId])
  @@index([projectId])
  @@index([invoiceNumber])
  @@index([parentInvoiceId])
  @@index([updatedAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  currency    String   @default("RSD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ProvidedService {
  id             String   @id @default(uuid())
  serviceId      String
  clientId       String
  projectId      String?
  invoiceId      String?
  status         String   @default("Planned")
  location       String?
  scheduledDate  String?
  completionDate String?
  price          Float?   @default(0)
  currency       String?  @default("RSD")
  notes          String?
  customData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([scheduledDate])
  @@index([completionDate])
  @@index([status])
  @@index([serviceId])
  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([updatedAt])
}

model CompanyInfo {
  id                 String   @id @default("default")
  name               String   @default("EKOS GREEN GROUP")
  legalName          String   @default("EKOS GREEN GROUP DOO Kraljevo")
  registrationNumber String   @default("21823759")
  municipality       String   @default("KRALJEVO")
  city               String   @default("KRALJEVO")
  streetAddress      String   @default("HEROJA MARIČIĆA 18")
  postalCode         String   @default("36000")
  postOffice         String   @default("KRALJEVO")
  email              String   @default("office@ekosgroup.rs")
  taxId              String   @default("113207057")
  activityCode       String   @default("7490 - Ostale stručne, naučne i tehničke delatnosti")
  bankAccounts       String[] @default(["325-9500700212451-35", "205-0000000547461-12", "205-0070100584938-90", "325-9601700087442-40", "325-9500700218732-10", "205-0000000525461-52"])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String   @default("MENTION")
  title      String
  message    String
  read       Boolean  @default(false)
  link       String?
  projectId  String?
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([projectId])
}

model ClientExtraData {
  id        String   @id @default(uuid())
  clientId  String   @unique
  permitId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  permit Permit? @relation(fields: [permitId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([permitId])
}

model Permit {
  id           String   @id @default(uuid())
  permitNumber String
  startDate    String?
  endDate      String?
  notes        String?
  permitTypes  String[] @default([])
  clientId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reminders       Reminder[]
  clientExtraData ClientExtraData[]
  permitWastes    PermitWaste[]

  @@index([endDate])
  @@index([startDate])
  @@index([clientId])
  @@index([permitNumber])
  @@index([updatedAt])
}

model WasteCatalog {
  id             String   @id @default(uuid())
  code           String   @unique
  description    String
  hazardListMark String?
  isHazardous    Boolean  @default(false)
  frequent       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permitWastes PermitWaste[]

  @@index([frequent])
}

model PermitWaste {
  id             String   @id @default(uuid())
  permitId       String
  wasteCatalogId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permit       Permit       @relation(fields: [permitId], references: [id], onDelete: Cascade)
  wasteCatalog WasteCatalog @relation(fields: [wasteCatalogId], references: [id], onDelete: Restrict)

  @@unique([permitId, wasteCatalogId])
  @@index([permitId])
  @@index([wasteCatalogId])
}

model Role {
  name          String   @id
  description   String?
  isSystemAdmin Boolean  @default(false)
  permissions   Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model ActivityLog {
  id              String   @id @default(uuid())
  userId          String
  userName        String?
  type            String
  path            String?
  details         String?
  durationSeconds Int?     @default(0)
  sessionId       String?
  timestamp       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([timestamp])
  @@index([sessionId])
  @@index([type, timestamp])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangeSet {
  id        String          @id @default(uuid())
  userId    String?
  userName  String?
  sessionId String?
  requestId String?
  method    String?
  route     String?
  source    String          @default("api") // api, import, seed, restore, system
  reason    String?
  createdAt DateTime        @default(now())
  versions  EntityVersion[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

model EntityVersion {
  id            BigInt    @id @default(autoincrement())
  changeSetId   String
  entityType    String    // e.g. "Project", "Invoice", "Client"
  entityId      String    // String PK of the record
  version       Int       // 1, 2, 3... per entity
  op            String    // I (Insert), U (Update), D (Delete), B (Baseline)
  kind          String    // S (Snapshot / Keyframe), D (Delta)
  data          Json      // Forward delta { field: newVal } or full row snapshot
  changedFields String[]  // For indexed search & quick filtering
  parentType    String?   // e.g. "Invoice" for InvoiceItem
  parentId      String?   // e.g. invoiceId for InvoiceItem
  createdAt     DateTime  @default(now())

  changeSet ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@index([parentType, parentId, createdAt])
  @@index([changeSetId])
}

model ActivityLogMonthlyStats {
  id                   String   @id @default(uuid())
  userId               String
  yearMonth            String   // e.g., "2026-10"
  totalDurationSeconds Int      @default(0)
  sessionCount         Int      @default(0)
  actionCount          Int      @default(0)
  moduleBreakdown      Json?    // { "/projects": 1200, "/invoices": 650, ... } — canonical path -> seconds
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
  @@index([yearMonth])
}

model ProjectNote {
  id          String   @id @default(uuid())
  projectId   String   @unique
  content     String?  @db.Text
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  versions    ProjectNoteVersion[]

  @@index([projectId])
}

model ProjectNoteVersion {
  id          BigInt   @id @default(autoincrement())
  noteId      String
  version     Int
  kind        String   // 'S' = Full Snapshot (Keyframe), 'D' = Text Delta Patch
  content     String?  @db.Text // Populated only when kind = 'S'
  patch       String?  @db.Text // Unified text diff patch when kind = 'D'
  charDelta   Int      @default(0) // Net characters added (+) or removed (-)
  authorId    String?
  authorName  String?
  reason      String?
  createdAt   DateTime @default(now())

  note        ProjectNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, version])
  @@index([noteId, kind, version])
  @@index([noteId, createdAt])
}


